# ciba-hitl-lab reads no per-app settings file. Port and bind come from the shell.
PORT=7580            # allowed range 7580-7589
# CIBA_BIND=0.0.0.0  # opt-in only; Docker sets this itself
#
# Real mode (rule 19) is configured from the ONE shared settings file ~/Development/.env, not here:
#   PINGONE_ENVIRONMENT_ID=...
#   PINGONE_WORKER_CLIENT_ID=...        (or PINGONE_WORKER_ID)
#   PINGONE_WORKER_CLIENT_SECRET=...    (or PINGONE_WORKER_SECRET)
#   CIBA_LAB_PERSON_TOKEN=...   (a real person access token from the owner's own sign-in)
#   CIBA_LAB_AUDIENCE=...       (the requested audience for the exchange)
# With any of these missing the Real button is disabled with a how-to tooltip and Mock answers everything.

# Host names (besides loopback) the lab answers to, e.g. local.ping-devops.com. The names must
# point at this Mac in /etc/hosts; TLS (LAB_TLS_CERT/LAB_TLS_KEY) makes them https.
#LAB_ALLOWED_HOSTS=local.ping-devops.com
